# ── Clé Groq (obligatoire) ─────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Modèles ────────────────────────────────────────────────────────────
# Modèle principal : reçoit les requêtes "sonnet" / "opus" de Claude Code.
# Recommandé : openai/gpt-oss-120b (131k de contexte, tool use, très rapide).
GROQ_MODEL=openai/gpt-oss-120b

# Petit modèle : reçoit les requêtes "haiku" (tâches de fond de Claude Code).
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# ── Serveur local ──────────────────────────────────────────────────────
# 127.0.0.1 uniquement par défaut. Ne pas exposer sur Internet.
HOST=127.0.0.1
PORT=8787

# Optionnel : exiger un jeton pour parler au proxy.
# Claude Code enverra ce jeton dans ANTHROPIC_AUTH_TOKEN.
# PROXY_API_KEY=change-me

# ── Limites ────────────────────────────────────────────────────────────
# Plafond de tokens de sortie. Les modèles Groq ont leurs propres limites,
# le proxy prend le minimum.
MAX_OUTPUT_TOKENS=32768

# Timeout d'une requête non-streamée / d'un stream complet (ms).
REQUEST_TIMEOUT_MS=300000
STREAM_TIMEOUT_MS=900000

# Taille maximale du corps JSON (images base64 incluses).
BODY_LIMIT_BYTES=26214400

# Nombre de retries sur 429 / 5xx / erreur réseau (0 = aucun).
GROQ_RETRIES=1

# ── Logs ───────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# Mettre à 0 pour désactiver le streaming vers Groq (le proxy synthétise
# alors les événements Anthropic à partir d'une réponse complète).
STREAMING=1
