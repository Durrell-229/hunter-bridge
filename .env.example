# ── Clés fournisseurs ─────────────────────────────────────────────────
# Au moins une clé est nécessaire. Le dashboard permet aussi de les
# saisir ; elles sont alors écrites dans ce fichier avec chmod 600.
# Ne colle jamais une clé dans un chat ou un ticket.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenCode Zen — https://opencode.ai/console
OPENCODE_API_KEY=

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ollama local (optionnel, pas de clé nécessaire si instance locale)
OLLAMA_API_KEY=

# ── Dashboard / administration ───────────────────────────────────────
# Recommandé si HOST n'est pas 127.0.0.1. Le dashboard reste accessible
# en local sans jeton, mais les routes admin sont alors limitées à la loopback.
# HUNTER_ADMIN_TOKEN=change-me

# Configuration des fournisseurs, profils, MCP et plugins.
# Générée par `npm run init` ; ne contient jamais les clés API.
# HUNTER_CONFIG=./hunter.config.json

# ── Modèles Groq historiques ──────────────────────────────────────────
# Conservés pour compatibilité. Le routage multi-fournisseurs utilise
# hunter.config.json ; ces valeurs restent les modèles Groq par défaut.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# ── Serveur local ──────────────────────────────────────────────────────
# 127.0.0.1 uniquement par défaut. Ne pas exposer sur Internet.
HOST=127.0.0.1
PORT=8787

# Optionnel : exiger un jeton pour parler au proxy.
# Claude Code enverra ce jeton dans ANTHROPIC_AUTH_TOKEN.
# PROXY_API_KEY=change-me

# ── Limites ────────────────────────────────────────────────────────────
# Plafond de tokens de sortie. Les modèles ont leurs propres limites,
# le proxy prend le minimum.
MAX_OUTPUT_TOKENS=32768

# Timeout d'une requête non-streamée / d'un stream complet (ms).
REQUEST_TIMEOUT_MS=300000
STREAM_TIMEOUT_MS=900000

# Taille maximale du corps JSON (images base64 incluses).
BODY_LIMIT_BYTES=26214400

# Nombre de retries par fournisseur sur 429 / 5xx / erreur réseau.
GROQ_RETRIES=1

# ── Logs ───────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# Mettre à 0 pour désactiver le streaming amont (le proxy synthétise
# alors les événements Anthropic à partir d'une réponse complète).
STREAMING=1
