{
  "name": "hunter-bridge",
  "version": "0.3.0",
  "description": "Hunter Bridge — proxy Anthropic Messages multi-fournisseurs, dashboard, routage CTF/bug bounty, MCP et plugins pour Claude Code",
  "type": "module",
  "bin": {
    "hunter": "./bin/hunter.js",
    "groqcc": "./bin/groqcc.js"
  },
  "scripts": {
    "start": "node bin/hunter.js start",
    "up": "node bin/hunter.js start",
    "claude": "node bin/hunter.js claude",
    "doctor": "node bin/hunter.js doctor",
    "models": "node bin/hunter.js models",
    "env": "node bin/hunter.js env",
    "init": "node bin/hunter.js init",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "claude-code",
    "hunter-bridge",
    "groq",
    "opencode-zen",
    "nvidia-nim",
    "gemini",
    "anthropic",
    "proxy",
    "ctf",
    "bug-bounty",
    "mcp",
    "llm"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    ".env.example",
    "LICENSE"
  ]
}
